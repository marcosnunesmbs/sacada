# Chave da OpenRouter (https://openrouter.ai/keys). Fica só no servidor local.
OPENROUTER_API_KEY=

# Modelo usado para escrever textos e questionários (qualquer id da OpenRouter).
OPENROUTER_MODEL=google/gemini-2.5-flash

# Quantas perguntas a IA cria por texto (5 a 15). Cada teste sorteia 5 delas.
QUIZ_PERGUNTAS=10

# Porta do servidor local.
PORT=3000
